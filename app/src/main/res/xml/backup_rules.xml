<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-API-31 backup rules. Moot while android:allowBackup is false;
    kept explicit so that flipping that flag doesn't start uploading
    ride history by default. See the note in AndroidManifest.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
